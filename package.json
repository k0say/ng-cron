{
  "name": "angular",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build-lib": "npm run clean && npm run build ng-cron && node prepare-package.mjs",
    "build-lib-alpha": "ALPHA=1 npm run build-lib",
    "clean": "rimraf dist",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "e2e": "npm run build-lib && npm run e2e-inject && npm run build e2e && cypress open --component",
    "e2e-run": "npm run build-lib && npm run e2e-inject && npm run build e2e && cypress run --component",
    "e2e-inject": "npm install ./dist/ng-cron --force",
    "publish-alpha": "npm publish ./dist/ng-cron --tag alpha --access=public",
    "publish": "npm publish ./dist/ng-cron --access=public"
  },
  "private": false,
  "engines": {
    "npm": ">=10.0.0",
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@angular/animations": "^21.2.17",
    "@angular/common": "^21.2.17",
    "@angular/compiler": "^21.2.17",
    "@angular/core": "^21.2.17",
    "@angular/forms": "^21.2.17",
    "@angular/platform-browser": "^21.2.17",
    "@angular/platform-browser-dynamic": "^21.2.17",
    "@angular/router": "^21.2.17",
    "@sbzen/cron-core": "2.0.2",
    "@sbzen/ng-cron": "file:dist/ng-cron",
    "bootstrap": "^5.3.0",
    "bootstrap-legacy": "npm:bootstrap@^4.6.1",
    "rxjs": "~7.8.1",
    "tslib": "^2.7.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^21.2.0",
    "@angular/cli": "^21.2.0",
    "@angular/compiler-cli": "^21.2.17",
    "@sbzen/e2e": "https://github.com/ua-cron/e2e/releases/download/20230106035216/dist.tar.gz",
    "@types/jasmine": "~5.1.4",
    "@types/node": "^22.12.0",
    "cypress": "^13.14.1",
    "jasmine-core": "~5.2.0",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.1",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "ng-packagr": "^21.2.0",
    "typescript": "~5.9.0"
  }
}
